{
  "name": "heroquest",
  "version": "1.0.0",
  "description": "reproduction du jeu de société heroquest : https://fr.wikipedia.org/wiki/HeroQuest_(jeu_de_soci%C3%A9t%C3%A9)",
  "main": "index.js",
  "scripts": {
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "install:all": "npm install && cd server && npm install && cd ../client && npm install",
    "test": "cd server && npm test && cd ../client && npm test",
    "test:server": "cd server && npm test",
    "test:client": "cd client && npm test",
    "test:server:watch": "cd server && npm run test:watch",
    "test:client:watch": "cd client && npm run test:watch",
    "test:server:coverage": "cd server && npm run test:coverage"
  },
  "devDependencies": {
    "concurrently": "^7.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jonas-LE-DUFF/heroquest.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Jonas-LE-DUFF/heroquest/issues"
  },
  "homepage": "https://github.com/Jonas-LE-DUFF/heroquest#readme",
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.3",
    "express": "^5.2.1",
    "nodemon": "^3.1.11",
    "react-toastify": "^11.0.5",
    "socket.io": "^4.8.3",
    "ts-node": "^10.9.2",
    "typeof": "^1.0.0",
    "uuid": "^13.0.0",
    "vite": "^7.3.1"
  }
}
